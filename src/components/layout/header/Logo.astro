---
const {
} = Astro.props;
---
<a href="/" class="header__left">
    <img
        id="site-logo"
        src="/assets/logo/prostate-care-logo-light.png"
        alt='Prostate Care Logo'
        class="object-contain"
    />
    <div class="header__left-title">
        <h2>Prostate Care</h2>
        <p>Prostate Cancer Website</p>
    </div>
</a>


<style>
    img {
        max-width: 75px;
        /* max-width: 16%; */

    }
    .header__left {
      display: flex;
      align-items: center;
      text-decoration: none;
      gap: 2;
      /* margin: 0; */

    }
    .header__left-title {
      width: 100%;
      margin: 0em 1em;

    }

    h2 {
        font-weight: 900;
        color: var(--color-palette-accent);
    }

    p {
        color: var(--color-palette-accent);
    }
  </style>
---
import HeaderLink from '../HeaderLink.astro';

---

<persona>
		<div class="internal-links">
			<HeaderLink href="/patient-space">Patient</HeaderLink>
			<HeaderLink href="/family">Family</HeaderLink>
			<HeaderLink href="/research">Research</HeaderLink>
		</div>
</persona>
<style>
	h2 {
		margin: 0;
		font-size: 1em;
	}

	h2 a,
	h2 a.active {
		text-decoration: none;
	}
	persona {
		display: flex;
		align-items: center;
		justify-content: space-between;
	}
	persona a {
		padding: 1em 0.5em;
		color: var(--black);
		border-bottom: 4px solid transparent;
		text-decoration: none;
	}
	persona a.active {
		text-decoration: none;
		border-bottom-color: var(--accent);
	}
	.social-links,
	.social-links a {
		display: flex;
	}
	@media (max-width: 720px) {
		.social-links {
			display: none;
		}
	}
</style>
